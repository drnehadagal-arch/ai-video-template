# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only: never expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# fal.ai API key (fal.ai dashboard -> Keys). Server only.
FAL_KEY=your-fal-key

# Free videos each signed-in user may generate before credits exist (weeks 3-4).
FREE_VIDEOS_PER_USER=1
